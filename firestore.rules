rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // CORE FUNCTIONS
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDeveloper() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'developer' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '').lower() == 'skezza82'
      );
    }

    // -------------------------------------------------------------------------
    // USER PROFILES
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isDeveloper());
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isDeveloper() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'questClubJoinedAwarded', 'questHandleAwarded', 'questAvatarAwarded', 'lastActive', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && isDeveloper();
      
      match /friends/{friendId} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // CLUBS & COMMUNITY
    // -------------------------------------------------------------------------
    
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      match /{allSub=**} { 
        allow read: if true; 
        allow write: if isAuthenticated(); 
      }
    }

    match /memberships/{membershipId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /join_requests/{requestId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /club_invites/{inviteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // GAMEPLAY & DATA
    // -------------------------------------------------------------------------

    match /weekly_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /season_standings/{standingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gotm/{gotmId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gotm_reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
