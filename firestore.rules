rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // CORE FUNCTIONS
    // -------------------------------------------------------------------------

    function isClubOwner(clubId) {
      return request.auth != null && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid;
    }

    function hasAdminAccess(clubId) {
      let membership = get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + clubId));
      return request.auth != null && membership != null && (membership.data.role == 'admin' || membership.data.role == 'owner');
    }

    function isDeveloper() {
      // Safely check for developer status
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'developer' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '').lower() == 'skezza82'
      );
    }

    // -------------------------------------------------------------------------
    // USER PROFILES
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Allow public read for username availability checks and discovery
      allow read: if true;
      // Allow users to manage their own profile
      allow create: if request.auth != null && (request.auth.uid == userId || isDeveloper());
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isDeveloper() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'questClubJoinedAwarded', 'questHandleAwarded', 'questAvatarAwarded'])
      );
      allow delete: if request.auth != null && isDeveloper();
      
      // Friends & Social subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // -------------------------------------------------------------------------
    // CLUBS & COMMUNITY
    // -------------------------------------------------------------------------
    
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isDeveloper() ||
        hasAdminAccess(clubId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if request.auth != null && (isDeveloper() || isClubOwner(clubId));

      // Message Board
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + clubId));
      }
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid || 
        hasAdminAccess(request.resource.data.clubId)
      );
      allow update: if request.auth != null && (
        hasAdminAccess(resource.data.clubId) ||
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessedAt']))
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        hasAdminAccess(resource.data.clubId)
      );
    }

    // Join Requests
    match /join_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        hasAdminAccess(resource.data.clubId) ||
        isDeveloper()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        hasAdminAccess(resource.data.clubId)
      );
    }

    // Club Invites
    match /club_invites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.receiverId == request.auth.uid || 
        request.auth.uid == resource.data.senderId ||
        isDeveloper()
      );
      allow create: if request.auth != null; // Typically from admin/owner
      allow update, delete: if request.auth != null && (
        resource.data.receiverId == request.auth.uid ||
        isDeveloper()
      );
    }

    // -------------------------------------------------------------------------
    // GAMEPLAY & DATA
    // -------------------------------------------------------------------------

    match /weekly_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && hasAdminAccess(request.resource.data.clubId);
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    match /season_standings/{standingId} {
      allow read: if true;
      allow write: if request.auth != null && hasAdminAccess(request.resource.data.clubId);
    }

    match /gotm/{gotmId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && hasAdminAccess(request.resource.data.clubId);
    }

    match /gotm_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
